---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Story from "../components/Story.astro";
import Schedule from "../components/Schedule.astro";
import Cards from "../components/Cards.astro";
import Gallery from "../components/Gallery.astro";
import Count from "../components/Count.astro";
import RsvpForm from "../components/RsvpForm.astro";
import PhotoAlbumQR from "../components/PhotoAlbumQR.astro";
---

<Layout>
    <Hero />
    <Story />
    <iframe src="https://www.google.com/maps/embed?pb=!1m28!1m12!1m3!1d22957.146791825035!2d20.807959481035258!3d44.008098266308295!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!4m13!3e0!4m5!1s0x475723162a5aa04d%3A0x3400f6394022de66!2zRHJhxI1hIG1vbmFzdGVyeSwgMlFHUSs0NSwgRHJhxI1h!3m2!1d44.0253125!2d20.787937499999998!4m5!1s0x462a15582a43a7a3%3A0x41f266fc58f6dcb4!2sEvent%20Centar%20Villa%20Rajcic%2C%20Drenovacki%20put%2C%20Kragujevac%2034104!3m2!1d43.985693399999995!2d20.833382!5e0!3m2!1sen!2srs!4v1777358956498!5m2!1sen!2srs" width="100%" height="450" style="border:border-t border-dashed py-12 backdrop-blur;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    <Schedule />
    <Cards />
    
    <!-- Заједничка секција за RSVP и QR код -->
    <section class="section is-visible">
        <div class="section__inner">
            <!-- Наслов који ће повући твој нови фонт (нпр. Marck Script) -->
            <h2 class="section__title">Потврда доласка и фотографије</h2>
            
            <!-- Tailwind Grid: 1 колона на мобилном, 2 колоне на већим екранима -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start mt-8">
                <RsvpForm />
                <PhotoAlbumQR />
            </div>
        </div>
    </section>

    <Gallery />
    <Count />
</Layout>
