---
import Card from "./Card.astro";
import { getEventData } from "../data/eventData";

const { cards = [] } = getEventData();

// 1. Tell Vite to find all images in that specific folder.
// Make sure this relative path is correct from THIS current file to the assets folder.
const images = import.meta.glob('../assets/wedshots/*.{jpeg,jpg,png,gif,webp}');
---

<section class="max-w-4xl mx-auto my-16 px-4">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {
            cards.map((card) => {
                // 2. Check if the image path from YAML exists in our glob import
                const imagePromise = images[card.image];

                return (
                    <a
                        href={card.href}
                        class="group block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2"
                    >
                        <Card
                            // 3. Pass the executed promise if it exists, otherwise pass null
                            image={imagePromise ? imagePromise() : null}
                            imageAlt={card.imageAlt}
                            title={card.title}
                            description={card.description}
                        />
                    </a>
                );
            })
        }
    </div>
</section>
