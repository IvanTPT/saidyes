---
// src/components/PhotoAlbumQR.astro
const albumUrl = "https://photos.app.goo.gl/c2U4wgFD8ifWJXMy9"; 
const qrCodeUrl = `https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=${encodeURIComponent(albumUrl)}&color=434a42&bgcolor=d6ccc2`;
// Напомена: додао сам &color=434a42 (primary боја) и &bgcolor=d6ccc2 (background боја) у QR API 
// како би и сам QR код изгледао као део сајта!
---

<!-- Додали смо 'card' класу -->
<div class="card qr-container">
  <h2>Поделите фотографије</h2>
  
  <p>Драги гости, помозите нам да сачувамо сваки тренутак! Скенирајте QR код својим телефоном и додајте слике и снимке у наш заједнички албум.</p>
  
  <div class="qr-code-wrapper">
    <img src={qrCodeUrl} alt="QR код за Google Photos албум" width="220" height="220" loading="lazy" />
  </div>

  <div class="link-container">
    <span class="or-text">или</span>
    <br/>
    <a href={albumUrl} target="_blank" rel="noopener noreferrer" class="link-btn">
      Кликните овде за приступ албуму
    </a>
  </div>
</div>

<style>
  .qr-container {
    width: 100%;
    padding: 2.5rem 2rem;
    border-radius: 1rem;
    text-align: center;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  h2 {
    color: var(--color-text-dark);
    margin-bottom: 1.5rem;
  }

  p {
    color: color-mix(in srgb, var(--color-primary) 80%, transparent 20%);
    line-height: 1.6;
    margin-bottom: 2rem;
    font-size: 1.05rem;
  }

  .qr-code-wrapper {
    display: inline-block;
    padding: 1rem;
    background: var(--color-background);
    border: 2px solid color-mix(in srgb, var(--color-accent), transparent 50%);
    border-radius: 1rem;
    margin-bottom: 1.5rem;
    transition: transform 0.3s ease;
  }

  .qr-code-wrapper:hover {
    transform: scale(1.03);
  }

  .qr-code-wrapper img {
    display: block;
    border-radius: 0.5rem;
  }

  .link-container { margin-top: 0.5rem; }

  .or-text {
    color: var(--color-primary);
    font-size: 0.9rem;
    font-style: italic;
    opacity: 0.7;
  }

  .link-btn {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.75rem 1.5rem;
    background-color: transparent;
    color: var(--color-accent);
    text-decoration: none;
    border-radius: 0.5rem;
    font-weight: 600;
    transition: all 0.3s ease;
    border: 1px solid var(--color-accent);
  }

  .link-btn:hover {
    background-color: var(--color-accent);
    color: var(--color-background);
  }
</style>
