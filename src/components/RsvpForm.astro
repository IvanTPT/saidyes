---
// src/components/RsvpForm.astro
---

<div class="rsvp-wrapper">
  <h2 id="form-title">Потврда доласка</h2>
  
  <form id="rsvp-form" class="rsvp-form">
    <fieldset>
      <legend>Ваши подаци</legend>
      <div class="input-group">
        <label for="firstName">Име</label>
        <input type="text" id="firstName" name="firstName" required placeholder="Унесите ваше име" />
      </div>
      <div class="input-group">
        <label for="lastName">Презиме</label>
        <input type="text" id="lastName" name="lastName" required placeholder="Унесите ваше презиме" />
      </div>
    </fieldset>

    <fieldset>
      <legend>Особе које долазе са вама</legend>
      <div id="guests-container"></div>
      <button type="button" id="add-guest-btn" class="secondary-btn">
        + Додај особу
      </button>
    </fieldset>

    <button type="submit" id="submit-btn" class="primary-btn">Потврди долазак</button>
  </form>

  <!-- Порука која се приказује након успешног слања -->
  <div id="success-message" class="success-message" style="display: none;">
    <svg xmlns="http://www.w3.org/2000/svg" class="success-icon" viewBox="0 0 20 20" fill="currentColor">
      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
    </svg>
    <h3>Хвала Вам што сте потврдили свој долазак, радујемо се скором виђењу.</h3>
  </div>
</div>

<script>
  const addGuestBtn = document.getElementById('add-guest-btn');
  const guestsContainer = document.getElementById('guests-container');
  const rsvpForm = document.getElementById('rsvp-form');
  const submitBtn = document.getElementById('submit-btn');
  const formTitle = document.getElementById('form-title');
  const successMessage = document.getElementById('success-message');

  let guestCount = 0;

  // Динамичко додавање поља на ћирилици
  addGuestBtn?.addEventListener('click', () => {
    guestCount++;
    
    const guestDiv = document.createElement('div');
    guestDiv.className = 'guest-row';
    guestDiv.innerHTML = `
      <div class="guest-input-group">
        <label>Име пратиоца ${guestCount}</label>
        <input type="text" name="guestFirstName[]" placeholder="Унесите име" required class="guest-input" />
      </div>
      <div class="guest-input-group">
        <label>Презиме пратиоца ${guestCount}</label>
        <input type="text" name="guestLastName[]" placeholder="Унесите презиме" required class="guest-input" />
      </div>
      <button type="button" class="remove-btn" title="Уклони особу">✖</button>
    `;

    guestDiv.querySelector('.remove-btn')?.addEventListener('click', () => {
      guestDiv.remove();
    });

    guestsContainer?.appendChild(guestDiv);
  });

  // Слање форме
  rsvpForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    if(submitBtn) submitBtn.textContent = 'Шаљем...';
    
    const formData = new FormData(rsvpForm as HTMLFormElement);
    const guestFirstNames = formData.getAll('guestFirstName[]');
    const guestLastNames = formData.getAll('guestLastName[]');

    let pratioci = [];
    for (let i = 0; i < guestFirstNames.length; i++) {
      pratioci.push(`${guestFirstNames[i]} ${guestLastNames[i]}`);
    }

    const data = {
      ime: formData.get('firstName'),
      prezime: formData.get('lastName'),
      pratioci: pratioci.join(', ')
    };

    try {
      // ЗАМЕНИ ОВО ТВОЈИМ GOOGLE APPS SCRIPT ЛИНКОМ
      const GOOGLE_SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbx8izZ0PWNXTl0RREHobK6P3b6NdixRGAnj9dpaTmzQfMtKSY6oZH8AIRiTDKhxemAG/exec'; 

      await fetch(GOOGLE_SCRIPT_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        body: JSON.stringify(data)
      });

      // Приказ лепе поруке захвалности и скривање форме
      rsvpForm.style.display = 'none';
      if(formTitle) formTitle.style.display = 'none';
      if(successMessage) successMessage.style.display = 'flex';

    } catch (error) {
      alert('Дошло је до грешке приликом слања. Покушајте поново.');
      if(submitBtn) submitBtn.textContent = 'Потврди долазак';
    }
  });
</script>

<style>
  .rsvp-wrapper {
    max-width: 500px;
    margin: 0 auto;
    padding: 2rem;
    background: #f9fafb;
    border-radius: 8px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    font-family: system-ui, sans-serif;
  }
  fieldset { border: none; padding: 0; margin: 0 0 1.5rem 0; }
  legend { font-weight: bold; margin-bottom: 1rem; color: #333; font-size: 1.1rem; }
  .input-group { display: flex; flex-direction: column; margin-bottom: 1rem; }
  .input-group label { margin-bottom: 0.5rem; font-size: 0.9rem; color: #555; }
  input { padding: 0.75rem; border: 1px solid #ccc; border-radius: 4px; font-size: 1rem; }
  
  button { cursor: pointer; font-weight: bold; border: none; border-radius: 4px; transition: background 0.2s; }
  .primary-btn { width: 100%; padding: 1rem; background-color: #2563eb; color: white; font-size: 1.1rem; }
  .primary-btn:hover { background-color: #1d4ed8; }
  .secondary-btn { padding: 0.5rem 1rem; background-color: #e5e7eb; color: #374151; }
  .secondary-btn:hover { background-color: #d1d5db; }

  /* Стилови за поруку захвалности */
  .success-message {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem 0;
    animation: fadeIn 0.5s ease-in-out;
  }
  .success-message h3 {
    color: #1f2937;
    font-size: 1.25rem;
    line-height: 1.6;
    margin-top: 1rem;
    font-weight: 500;
  }
  .success-icon {
    width: 60px;
    height: 60px;
    color: #16a34a; /* Зелена боја за успех */
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<style is:global>
  /* ГЛОБАЛНИ стилови за елементе које убацујемо преко JavaScript-а */
  .guest-row {
    display: flex;
    gap: 1rem;
    align-items: flex-end; 
    margin-bottom: 1rem;
    background: #ffffff;
    padding: 1rem;
    border-radius: 6px;
    border: 1px solid #d1d5db;
    box-shadow: inset 0 2px 4px rgba(0,0,0,0.02);
  }

  .guest-input-group {
    display: flex;
    flex-direction: column;
    flex: 1; 
  }

  .guest-input-group label {
    margin-bottom: 0.5rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: #4b5563;
  }

  .guest-input {
    padding: 0.75rem;
    border: 1px solid #9ca3af;
    border-radius: 4px;
    font-size: 1rem;
    width: 100%;
    box-sizing: border-box;
  }

  .remove-btn {
    background-color: #ef4444;
    color: white;
    padding: 0.75rem 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 42px; 
  }

  .remove-btn:hover {
    background-color: #dc2626;
  }
</style>
