---
// src/components/RsvpForm.astro
---

<div class="rsvp-wrapper">
  <h2>Potvrda dolaska</h2>
  <form id="rsvp-form" class="rsvp-form">
    <!-- Podaci glavnog gosta -->
    <fieldset>
      <legend>Vaši podaci</legend>
      <div class="input-group">
        <label for="firstName">Ime</label>
        <input type="text" id="firstName" name="firstName" required placeholder="Unesite ime" />
      </div>
      <div class="input-group">
        <label for="lastName">Prezime</label>
        <input type="text" id="lastName" name="lastName" required placeholder="Unesite prezime" />
      </div>
    </fieldset>

    <!-- Sekcija za dodatne goste -->
    <fieldset>
      <legend>Osobe koje dolaze sa vama</legend>
      <div id="guests-container"></div>
      <button type="button" id="add-guest-btn" class="secondary-btn">
        + Dodaj osobu
      </button>
    </fieldset>

    <button type="submit" class="primary-btn">Potvrdi dolazak</button>
  </form>
</div>

<script>
  // Klijentski JavaScript za dinamičko dodavanje polja
  const addGuestBtn = document.getElementById('add-guest-btn');
  const guestsContainer = document.getElementById('guests-container');
  const rsvpForm = document.getElementById('rsvp-form');

  let guestCount = 0;

  // Funkcija za dodavanje novog gosta
  addGuestBtn?.addEventListener('click', () => {
    guestCount++;
    
    const guestDiv = document.createElement('div');
    guestDiv.className = 'guest-row';
    guestDiv.innerHTML = `
      <div class="input-group">
        <input type="text" name="guestFirstName[]" placeholder="Ime ${guestCount}" required />
      </div>
      <div class="input-group">
        <input type="text" name="guestLastName[]" placeholder="Prezime ${guestCount}" required />
      </div>
      <button type="button" class="remove-btn">✖</button>
    `;

    // Funkcionalnost za brisanje određenog gosta
    guestDiv.querySelector('.remove-btn')?.addEventListener('click', () => {
      guestDiv.remove();
    });

    guestsContainer?.appendChild(guestDiv);
  });

  // Obrada slanja forme
  rsvpForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    
    // Prikupljanje svih podataka iz forme
    const formData = new FormData(rsvpForm as HTMLFormElement);
    const data = {
      glavniGost: {
        ime: formData.get('firstName'),
        prezime: formData.get('lastName'),
      },
      pratioci: [] as { ime: string; prezime: string }[]
    };

    // Ekstrakcija podataka o dodatnim gostima (nizovi)
    const guestFirstNames = formData.getAll('guestFirstName[]');
    const guestLastNames = formData.getAll('guestLastName[]');

    for (let i = 0; i < guestFirstNames.length; i++) {
      data.pratioci.push({
        ime: guestFirstNames[i].toString(),
        prezime: guestLastNames[i].toString(),
      });
    }

    // Ovde možeš poslati 'data' na neki API (npr. Astro API endpoint ili backend)
    console.log('Prikupljeni podaci:', data);
    alert('Hvala! Vaš dolazak je uspešno potvrđen.');
    (rsvpForm as HTMLFormElement).reset();
    if(guestsContainer) guestsContainer.innerHTML = ''; // Očisti listu gostiju
  });
</script>

<style>
  /* Osnovno stilizovanje forme (Astro automatski izoluje CSS za ovu komponentu) */
  .rsvp-wrapper {
    max-width: 500px;
    margin: 0 auto;
    padding: 2rem;
    background: #f9fafb;
    border-radius: 8px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    font-family: system-ui, sans-serif;
  }

  fieldset {
    border: none;
    padding: 0;
    margin: 0 0 1.5rem 0;
  }

  legend {
    font-weight: bold;
    margin-bottom: 1rem;
    color: #333;
    font-size: 1.1rem;
  }

  .input-group {
    display: flex;
    flex-direction: column;
    margin-bottom: 1rem;
  }

  .input-group label {
    margin-bottom: 0.5rem;
    font-size: 0.9rem;
    color: #555;
  }

  input {
    padding: 0.75rem;
    border: 1px solid #ccc;
    border-radius: 4px;
    font-size: 1rem;
  }

  .guest-row {
    display: flex;
    gap: 1rem;
    align-items: center;
    margin-bottom: 1rem;
    background: #fff;
    padding: 1rem;
    border-radius: 4px;
    border: 1px dashed #ccc;
  }

  .guest-row .input-group {
    margin-bottom: 0;
    flex: 1;
  }

  button {
    cursor: pointer;
    font-weight: bold;
    border: none;
    border-radius: 4px;
    transition: background 0.2s;
  }

  .primary-btn {
    width: 100%;
    padding: 1rem;
    background-color: #2563eb;
    color: white;
    font-size: 1.1rem;
  }

  .primary-btn:hover {
    background-color: #1d4ed8;
  }

  .secondary-btn {
    padding: 0.5rem 1rem;
    background-color: #e5e7eb;
    color: #374151;
  }

  .secondary-btn:hover {
    background-color: #d1d5db;
  }

  .remove-btn {
    background-color: #ef4444;
    color: white;
    padding: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .remove-btn:hover {
    background-color: #dc2626;
  }
</style>
